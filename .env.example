# MomBoard environment configuration
# Copy to .env and fill in values

# ─── Required ─────────────────────────────────────────────────────────────────

# Auth (MUST change in production — use: openssl rand -base64 32)
SESSION_SECRET=change-me-in-production-use-a-random-32-char-string

# OpenAI (leave empty to use FakeLLMClient in dev)
OPENAI_API_KEY=

# ─── Optional ─────────────────────────────────────────────────────────────────

# Database (SQLite by default; PostgreSQL requires the postgres optional dependency)
DATABASE_URL=sqlite+aiosqlite:///data/momboard.db
# DATABASE_URL=postgresql+asyncpg://momboard:secret@localhost:5432/momboard

# OpenAI Responses API base URL (or a fully compatible proxy)
OPENAI_BASE_URL=https://api.openai.com/v1

# LLM backend selection: openai or local
LLM_BACKEND=openai

# Model selection per agent (OpenAI backend only)
LLM_MODEL_NORMALIZER=gpt-5-mini
LLM_MODEL_TAGGER=gpt-5-mini
LLM_MODEL_ANALYST=gpt-5-mini
LLM_MODEL_SYNTHESIZER=gpt-5-mini

# ─── Local LLM (Ollama) ──────────────────────────────────────────────────────
# Activate with: docker compose --profile local-llm up -d
# See docs/local-llm.md for full guide.

# LLM_BACKEND=local
# LLM_BASE_URL=http://ollama:11434
# LLM_LOCAL_MODEL=qwen3:8b
# LLM_LOCAL_TIMEOUT=300
# LLM_MAX_CONTEXT=8192

# Worker
WORKER_POLL_INTERVAL=2.0
WORKER_MAX_RETRIES=3

# ─── Vexa Meeting Bot (T36) ──────────────────────────────────────────────────
# Disabled by default. Set both to enable meeting recording integration.
# VEXA_BASE_URL=https://api.vexa.ai/v1
# VEXA_API_KEY=

# App
ENV=development
PORT=8000
