# MomBoard environment configuration
# Copy to .env and fill in values

# ─── Required ─────────────────────────────────────────────────────────────────

# Auth (MUST change in production — use: openssl rand -base64 32)
SESSION_SECRET=change-me-in-production-use-a-random-32-char-string

# OpenAI (leave empty to use FakeLLMClient in dev)
OPENAI_API_KEY=

# ─── Optional ─────────────────────────────────────────────────────────────────

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite+aiosqlite:///data/momboard.db
# DATABASE_URL=postgresql+asyncpg://momboard:secret@localhost:5432/momboard

# OpenAI base URL (for proxies or compatible APIs)
OPENAI_BASE_URL=https://api.openai.com/v1

# Model selection per agent
LLM_MODEL_NORMALIZER=gpt-4o-mini
LLM_MODEL_TAGGER=gpt-4o
LLM_MODEL_ANALYST=gpt-4o
LLM_MODEL_SYNTHESIZER=gpt-4o

# Worker
WORKER_POLL_INTERVAL=2.0
WORKER_MAX_RETRIES=3

# App
ENV=development
PORT=8000
